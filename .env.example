# CMS + Autopilot
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Admin login
CMS_ADMIN_EMAIL=admin@example.com
CMS_ADMIN_PASSWORD=change-me
# Or use a bcrypt hash instead of plain password:
# CMS_ADMIN_PASSWORD_HASH=

NEXTAUTH_SECRET=generate-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# Media uploads (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Ezoic ads.txt Manager (from old WP site)
EZOIC_ADSTXT_MANAGER_ID=20975
EZOIC_ADSTXT_DOMAIN=simplelifesaver.com

# Optional GA4 override (the production measurement ID is the code default)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-Y029QN6YPB

# Deploy hook triggered after publish
VERCEL_DEPLOY_HOOK_URL=

# Optional: enables efficient, batched checks in Admin > YouTube Cleanup.
# Without this, the tool falls back to YouTube's public oEmbed endpoint.
YOUTUBE_API_KEY=

# Topic Source safety limits (optional server-side overrides)
TOPIC_SOURCE_FETCH_TIMEOUT_MS=8000
TOPIC_SOURCE_MAX_RESPONSE_BYTES=1500000
TOPIC_SOURCE_MAX_EXTRACTED_CHARS=50000

# OpenRouter (server-only; never expose with NEXT_PUBLIC_*)
# Required for Topic Inbox and article editor AI suggestions.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional overrides
OPENROUTER_TIMEOUT_MS=30000
OPENROUTER_MAX_RESPONSE_BYTES=500000
OPENROUTER_SITE_URL=https://simplelifesaver.com
OPENROUTER_APP_NAME=Simple Life Saver CMS
OPENROUTER_TOPIC_MAX_SOURCE_CHARS=12000
OPENROUTER_ARTICLE_MAX_HTML_CHARS=20000

# Cron protection
CRON_SECRET=

# Autopilot defaults
AUTOPILOT_ENABLED=false
AUTOPILOT_AUTO_PUBLISH=false
AUTOPILOT_TIMEZONE=America/New_York

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
