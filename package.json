    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.3",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.56.0",
    "vitest": "^4.1.0"
